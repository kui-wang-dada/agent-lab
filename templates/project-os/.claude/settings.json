{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "项目 OS 模板 scaffold settings.json（只管权限护栏）。hooks 已上移到 project-os plugin（marketplace 安装，机器层不在 scaffold 里以免 drift；安装见 README §3）。deny/allow 的代码路径用 <<占位符>>，实例化时按 PROJECT.md §4 的 <<FRAMEWORK_BASE_PATHS>> / <<BUSINESS_MODULE_PATHS>> 展开成真实 glob。破坏性命令 deny 是 generic，直接生效无需改。defaultMode=acceptEdits：业务子树内的编辑免确认，靠 deny 兜底护栏。",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(.claude/memory/**)",
      "Write(.claude/memory/**)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(doc/**)",
      "Edit(daily/**)",
      "Write(daily/**)",
      "Write(doc/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(<<BUSINESS_MODULE_PATHS>>)",
      "Write(<<BUSINESS_MODULE_PATHS>>)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(mvn:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(lsof:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Edit(<<FRAMEWORK_BASE_PATHS>>)",
      "Write(<<FRAMEWORK_BASE_PATHS>>)"
    ]
  }
}
